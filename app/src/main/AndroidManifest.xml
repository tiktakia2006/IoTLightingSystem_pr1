<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Дозвіл на доступ до Інтернету — знадобиться на майбутніх етапах
        для реальної інтеграції з IoT-хмарою/брокером (MQTT/HTTP API),
        поки що використовується лише емуляція даних датчиків.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.IoTLightingSystem"
        tools:targetApi="34">

        <!-- Практичне заняття № 1: Hello World / вибір рівня складності -->
        <activity
            android:name="ua.kpi.practical_example_1.MainActivity"
            android:exported="true"
            android:label="ПЗ №1 — Hello IoT Lighting"
            android:theme="@style/Theme.IoTLightingSystem">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Практичне заняття № 2: Gradle, структура проєкту, IoTCalculator -->
        <activity
            android:name="ua.kpi.practical_example_2.MainActivity"
            android:exported="true"
            android:label="ПЗ №2 — Розрахунок енергоспоживання" />

        <!-- Практичне заняття № 3: composable-функції, layout, зображення, кнопки -->
        <activity
            android:name="ua.kpi.practical_example_3.MainActivity"
            android:exported="true"
            android:label="ПЗ №3 — Панель керування освітленням" />

        <!-- Практичне заняття № 4: авторизація та реєстрація користувача -->
        <activity
            android:name="ua.kpi.practical_example_4.MainActivity"
            android:exported="true"
            android:label="ПЗ №4 — Вхід у систему" />

    </application>

</manifest>
